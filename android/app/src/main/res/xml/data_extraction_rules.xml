<?xml version="1.0" encoding="utf-8"?>
<!-- Oturum belirteci (rc/readcrab.db) ve indirilen içerik yedeğe ve cihazdan cihaza aktarıma girmez.
     Android 12+ hedefinde allowBackup="false" cihazdan cihaza aktarımı kapatmaz; bu kurallar kapatır. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
